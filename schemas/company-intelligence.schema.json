{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company intelligence import",
  "description": "Six company tables in the existing shared job/company JSON document. Unrelated metadata is preserved.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Canonical storage writes 8; import does not validate this marker."
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "jobs": {
      "type": "array"
    },
    "applications": {}
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "companies"
      ]
    },
    {
      "required": [
        "jobs"
      ]
    },
    {
      "required": [
        "applications"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "not": {
          "required": [
            "jobs"
          ],
          "properties": {
            "jobs": {
              "contains": {
                "type": "object",
                "required": [
                  "job"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/normalizedJob"
            }
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "jobs"
          ]
        },
        "then": {
          "properties": {
            "jobs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/job"
              }
            }
          }
        },
        "else": {
          "properties": {
            "applications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/job"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "enum": [
        "Research",
        "Access",
        "Execution",
        "Financing",
        "Performance",
        "Risk",
        "Distribution",
        "Technology",
        "Service",
        "Trust",
        null,
        ""
      ],
      "description": "One controlled Value tag; null or the legacy empty string means unknown."
    },
    "terms": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "company": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strategy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "department": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revenue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rank": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "makeup": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "department": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revenue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scale": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "department": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revenue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "growth": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "edge": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "client": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "engagement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "franchise": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "footprint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "leadership": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "composition": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "normalizedJob": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "$ref": "#/$defs/terms"
        },
        "coverage": {
          "$ref": "#/$defs/terms"
        },
        "geography": {
          "$ref": "#/$defs/terms"
        },
        "client_segment": {
          "$ref": "#/$defs/terms"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "company": {
          "$ref": "#/$defs/nonblank"
        },
        "role": {
          "$ref": "#/$defs/nonblank"
        },
        "when": {
          "$ref": "#/$defs/nonblank"
        },
        "deadline": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "company",
        "role",
        "when"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "action"
            ]
          },
          {
            "required": [
              "Action"
            ]
          }
        ]
      },
      "description": "Normalized version-1 job. The importer additionally checks timing syntax/calendar validity, deadlines, duplicate trimmed IDs, and filesystem names."
    },
    "canonicalJob": {
      "type": "object",
      "properties": {
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "$ref": "#/$defs/terms"
        },
        "coverage": {
          "$ref": "#/$defs/terms"
        },
        "geography": {
          "$ref": "#/$defs/terms"
        },
        "client_segment": {
          "$ref": "#/$defs/terms"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "company": {
          "$ref": "#/$defs/nonblank"
        },
        "job": {
          "$ref": "#/$defs/nonblank"
        },
        "deadline": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "portal": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "brochure": {
          "type": "string"
        },
        "description_text": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "resume": {
          "type": "string"
        },
        "letter": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "apply": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "company",
        "job"
      ],
      "description": "Canonical job. Remaining internal/legacy fields are preserved or normalized by ApplicationRecord. Action is not enumerated because canonical imports preserve legacy actions. Timing, deadlines, identity uniqueness and filesystem constraints are also checked by the application."
    },
    "job": {
      "if": {
        "required": [
          "role"
        ],
        "not": {
          "required": [
            "job"
          ]
        }
      },
      "then": {
        "$ref": "#/$defs/normalizedJob"
      },
      "else": {
        "$ref": "#/$defs/canonicalJob"
      }
    }
  }
}
